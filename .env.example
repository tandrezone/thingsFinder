# thingsFinder settings. Copy to .env and adjust; every line is optional.
# Real environment variables (e.g. Apache SetEnv, systemd, Docker) win over
# this file. .env is read via vlucas/phpdotenv, so run `composer install`.
# Never commit .env, and keep it out of the web root's reach (the bundled
# .htaccess, router.php and setup.sh already block it).

# Public URL of the web app, used in invite links and QR codes. Leave empty to
# use the host of each request. Set it when the API runs on its own host
# (e.g. api.example.com) or behind a proxy.
TF_APP_URL=

# Open sign-up at /register and POST /api/auth/register (on/off).
TF_REGISTRATION=on

# SQLite database file — absolute, or relative to the project root.
TF_DB_PATH=data/database.sqlite

# Suggest names for unknown barcodes via Open Food Facts / UPCitemdb (on/off).
# Off means thingsFinder never makes an outbound request.
TF_BARCODE_LOOKUP=on

# How many days an Android app sign-in (API token) stays valid.
TF_TOKEN_TTL_DAYS=365
