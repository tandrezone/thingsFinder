<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="thingsfinder.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="thingsfinder.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
