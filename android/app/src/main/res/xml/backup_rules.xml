<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: include the inventory database and settings in Google auto-backup. -->
<full-backup-content>
    <include domain="database" path="thingsfinder.db" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <!-- The cloud sign-in token must never be copied into a backup or onto another device. -->
    <exclude domain="file" path="datastore/cloud.preferences_pb" />
</full-backup-content>
