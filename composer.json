{
    "name": "thingsfinder/thingsfinder",
    "description": "Self-hosted inventory for places, boxes and items — PHP + SQLite web app and JSON API.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "ext-gd": "PNG QR codes and labels",
        "ext-curl": "Barcode name lookups (falls back to file_get_contents)"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t web router.php"
        ],
        "serve:api": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8001 -t api api/index.php"
        ]
    }
}
